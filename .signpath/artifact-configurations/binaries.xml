<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "binaries": Echo's own programs, signed before they go into the installer. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="Echo.exe" />
      <include path="Echo.dll" />
      <include path="Echo.Core.dll" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
